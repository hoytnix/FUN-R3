{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".write": "auth != null && (!data.exists() && newData.child('hostId').val() === auth.uid)",

        "roomCode": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "createdAt": {
          ".read": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "hostId": {
          ".read": "auth != null",
          ".validate": "newData.isString() && newData.val() === auth.uid",
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "status": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid",
          ".validate": "newData.isString() && (newData.val() === 'LOBBY_WAITING' || newData.val() === 'DEAL_HANDS' || newData.val() === 'PLAYER_TURN' || newData.val() === 'TRICK_EVALUATION' || newData.val() === 'ROUND_END' || newData.val() === 'GAME_OVER')"
        },
        "dealerIndex": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "currentRound": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4"
        },
        "scores": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid"
        },
        "totalScores": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid"
        },
        "turnSeatIndex": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($roomId).child('hostId').val() === auth.uid || root.child('rooms').child($roomId).child('players').child(auth.uid).child('seatIndex').val() === data.val())",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "turnDeadline": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "leadSuit": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "!newData.exists() || newData.val() === null || newData.val() === 'HEARTS' || newData.val() === 'DIAMONDS' || newData.val() === 'CLUBS' || newData.val() === 'SPADES'"
        },
        "players": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$playerId": {
            ".write": "auth != null && ($playerId === auth.uid || root.child('rooms').child($roomId).child('hostId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['id', 'name', 'seatIndex']) && newData.child('seatIndex').isNumber() && newData.child('seatIndex').val() >= 0 && newData.child('seatIndex').val() <= 3"
          }
        },
        "hands": {
          "$playerId": {
            ".read": "auth != null && $playerId === auth.uid",
            ".write": "auth != null && (root.child('rooms').child($roomId).child('hostId').val() === auth.uid || $playerId === auth.uid)",
            "$cardIndex": {
              ".validate": "newData.hasChildren(['suit', 'value']) && (newData.child('suit').val() === 'HEARTS' || newData.child('suit').val() === 'DIAMONDS' || newData.child('suit').val() === 'CLUBS' || newData.child('suit').val() === 'SPADES') && newData.child('value').isNumber() && newData.child('value').val() >= 2 && newData.child('value').val() <= 14"
            }
          }
        },
        "currentTrick": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($roomId).child('hostId').val() === auth.uid || !newData.exists())",
          "$playerId": {
            ".write": "auth != null && ($playerId === auth.uid || root.child('rooms').child($roomId).child('hostId').val() === auth.uid) && (root.child('rooms').child($roomId).child('hostId').val() === auth.uid || root.child('rooms').child($roomId).child('players').child($playerId).child('seatIndex').val() === root.child('rooms').child($roomId).child('turnSeatIndex').val())",
            ".validate": "(newData.hasChildren(['suit', 'value']) && (newData.child('suit').val() === 'HEARTS' || newData.child('suit').val() === 'DIAMONDS' || newData.child('suit').val() === 'CLUBS' || newData.child('suit').val() === 'SPADES') && newData.child('value').isNumber() && newData.child('value').val() >= 2 && newData.child('value').val() <= 14) || (newData.hasChildren(['card']) && (newData.child('card/suit').val() === 'HEARTS' || newData.child('card/suit').val() === 'DIAMONDS' || newData.child('card/suit').val() === 'CLUBS' || newData.child('card/suit').val() === 'SPADES') && newData.child('card/value').isNumber() && newData.child('card/value').val() >= 2 && newData.child('card/value').val() <= 14)"
          }
        },
        "lastCompletedTrick": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostId').val() === auth.uid"
        },
        "solitaireBoard": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "solitairePlacements": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "solitairePassedSeats": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "chatMessages": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "reactions": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "lastActionMessage": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
